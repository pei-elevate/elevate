# Copy to .env and change the values. Every variable has a development default in compose.yml.

# Database (PostgreSQL)
POSTGRES_USER=elevate
POSTGRES_PASSWORD=elevate
POSTGRES_DB=elevate

# Authentik (only with: docker compose --profile auth up)
AUTHENTIK_SECRET_KEY=change-me-in-your-env-file
AUTHENTIK_DB_PASSWORD=authentik
